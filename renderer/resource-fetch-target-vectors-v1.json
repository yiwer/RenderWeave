{
  "vectorVersion": "renderweave-resource-fetch-target-vectors/1",
  "authorityContext": {
    "engineStage": "RESOURCE_PREPARATION",
    "assetFetchPathPrefix": "/internal/render-assets",
    "targetInput": "TYPED_RENDER_RESOURCE",
    "transportImplementation": "UNWIRED",
    "resourceBytes": "UNFETCHED",
    "daemonOutputPath": "UNWIRED",
    "profileAvailability": "NOT_REGISTERED",
    "certificationStatus": "NOT_CERTIFIED",
    "processRasterImplementation": "ABSENT",
    "productRoute": "CLOSED",
    "providerAttempts": 0
  },
  "policyCases": [
    {
      "id": "canonical-lowercase-origin",
      "origin": "https://render.internal.example",
      "expected": {"outcome": "ADMITTED"}
    },
    {
      "id": "canonical-nondefault-port-origin",
      "origin": "https://render.internal.example:8443",
      "expected": {"outcome": "ADMITTED"}
    },
    {
      "id": "reject-empty-origin",
      "origin": "",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-http-origin",
      "origin": "http://render.internal.example",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-uppercase-host-origin",
      "origin": "https://Render.internal.example",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-explicit-default-port-origin",
      "origin": "https://render.internal.example:443",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-leading-zero-port-origin",
      "origin": "https://render.internal.example:08443",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-trailing-slash-origin",
      "origin": "https://render.internal.example/",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-origin-with-path",
      "origin": "https://render.internal.example/internal",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-userinfo-origin",
      "origin": "https://user@render.internal.example",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-query-origin",
      "origin": "https://render.internal.example?x=1",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-fragment-origin",
      "origin": "https://render.internal.example#x",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-percent-host-origin",
      "origin": "https://r%65nder.internal.example",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-trailing-dot-host-origin",
      "origin": "https://render.internal.example.",
      "expected": {"outcome": "REJECTED"}
    }
  ],
  "targetCases": [
    {
      "id": "admit-current-renderer-token-path",
