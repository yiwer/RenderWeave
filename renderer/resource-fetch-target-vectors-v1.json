      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-backslash-path",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example/internal/render-assets/token\\admin",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-query-target",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example/internal/render-assets/token?x=1",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-fragment-target",
      "origin": "https://render.internal.example",
