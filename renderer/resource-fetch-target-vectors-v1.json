      "fetchUrl": "https://render.internal.example/internal/render-assets/v1.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.4090912502.ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopq",
      "expected": {"outcome": "ADMITTED"}
    },
    {
      "id": "admit-nested-unreserved-path",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example/internal/render-assets/v2/token_part-1/~proof",
      "expected": {"outcome": "ADMITTED"}
    },
    {
      "id": "admit-matching-nondefault-port",
      "origin": "https://render.internal.example:8443",
      "fetchUrl": "https://render.internal.example:8443/internal/render-assets/token",
      "expected": {"outcome": "ADMITTED"}
    },
    {
      "id": "reject-http-target",
      "origin": "https://render.internal.example",
