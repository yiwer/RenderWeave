      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-dot-segment",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example/internal/render-assets/./token",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-dot-dot-segment",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example/internal/render-assets/../admin",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-percent-encoded-path",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example/internal/render-assets/%2e%2e/admin",
      "expected": {"outcome": "REJECTED"}
    },
    {
