      "fetchUrl": "https://Render.internal.example/internal/render-assets/token",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-explicit-default-port-target",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example:443/internal/render-assets/token",
      "expected": {"outcome": "REJECTED"}
    },
    {
      "id": "reject-userinfo-target",
      "origin": "https://render.internal.example",
      "fetchUrl": "https://render.internal.example@evil.example/internal/render-assets/token",
      "expected": {"outcome": "REJECTED"}
    },
