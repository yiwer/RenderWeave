{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderweave.local/schemas/image-only-profile-certification-authorization-v1.json",
  "title": "RenderWeave IMAGE_ONLY Profile Certification J1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "authorizationId", "status", "cycleId", "stage", "profileId",
    "profileSha256", "manifestIdentity", "evaluatorIdentity", "provider", "model",
    "providerBaseUrl", "inputProvenance", "dataClassification", "cases", "maximumRuns",
    "maximumProviderCalls", "maximumModelTokens", "maximumCostMicrosCny",
    "maximumProviderCallsPerRun", "maximumCostPerRunMicrosCny", "effectiveAt",
    "expiresAt", "approvedBy", "approvedAt", "approvalScope", "closedAt", "closureReason"
  ],
  "properties": {
    "version": { "const": "renderweave-image-only-certification-authorization/1.0" },
    "authorizationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
    "status": { "enum": ["PROPOSED", "OPEN", "CLOSED"] },
    "cycleId": { "type": "string", "format": "uuid" },
    "stage": {
      "enum": ["CANARY_5", "DEV_20", "FINAL_60", "PROFILE_SUCCESSOR_DIAGNOSTIC_1"]
    },
    "profileId": {
      "enum": [
        "dashscope-qwen38-max-product-v46-hybrid-generic",
        "dashscope-qwen38-max-product-v47-hybrid-generic",
        "dashscope-qwen38-max-product-v48-hybrid-generic",
        "dashscope-qwen38-max-product-v49-hybrid-generic",
        "dashscope-qwen38-max-product-v50-hybrid-generic",
        "dashscope-qwen38-max-product-v51-hybrid-generic"
      ]
    },
    "profileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestIdentity": {
      "type": "string",
      "pattern": "^renderweave-image-only-(?:certification-manifest|profile-successor-diagnostic)/1\\.0:[0-9a-f]{64}$"
    },
    "evaluatorIdentity": {
      "type": "string",
      "pattern": "^renderweave-image-only-(?:certification-evaluator|profile-successor-diagnostic-evaluator)/1\\.0:[0-9a-f]{64}$"
    },
    "normalizationIdentity": {
      "type": ["string", "null"],
      "pattern": "^renderweave-image-only-fresh-normalization/1\\.0:[0-9a-f]{64}$"
    },
    "provider": { "const": "DASHSCOPE" },
    "model": { "const": "qwen3.8-max" },
    "providerBaseUrl": { "const": "https://dashscope.aliyuncs.com/compatible-mode/v1" },
    "inputProvenance": { "const": "USER_PROVIDED" },
    "dataClassification": { "const": "ORDINARY_DESIGN" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "artifactSha256"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
          "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "maximumRuns": { "type": "integer", "minimum": 1, "maximum": 60 },
    "maximumProviderCalls": { "type": "integer", "minimum": 1, "maximum": 720 },
    "maximumModelTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "maximumCostMicrosCny": { "type": "integer", "minimum": 1, "maximum": 360000000 },
    "maximumProviderCallsPerRun": { "type": "integer", "minimum": 1, "maximum": 12 },
    "maximumCostPerRunMicrosCny": {
      "type": "integer", "minimum": 1, "maximum": 6000000
    },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "type": "string", "minLength": 1, "maxLength": 256 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvalScope": {
      "enum": [
        "IMAGE_ONLY_PROFILE_CERTIFICATION_CANARY_5",
        "IMAGE_ONLY_PROFILE_CERTIFICATION_DEV_20",
        "IMAGE_ONLY_PROFILE_CERTIFICATION_FINAL_60",
        "IMAGE_ONLY_PROFILE_SUCCESSOR_DIAGNOSTIC_1"
      ]
    },
    "closedAt": { "type": ["string", "null"], "format": "date-time" },
    "closureReason": { "type": ["string", "null"], "maxLength": 256 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "CLOSED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "closedAt": { "type": "string", "format": "date-time" },
          "closureReason": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "else": {
        "properties": {
          "closedAt": { "const": null },
          "closureReason": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "stage": { "const": "PROFILE_SUCCESSOR_DIAGNOSTIC_1" } },
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "profileId": {
            "enum": [
              "dashscope-qwen38-max-product-v47-hybrid-generic",
              "dashscope-qwen38-max-product-v48-hybrid-generic",
              "dashscope-qwen38-max-product-v49-hybrid-generic",
              "dashscope-qwen38-max-product-v50-hybrid-generic",
              "dashscope-qwen38-max-product-v51-hybrid-generic"
            ]
          },
          "manifestIdentity": {
            "pattern": "^renderweave-image-only-profile-successor-diagnostic/1\\.0:[0-9a-f]{64}$"
          },
          "evaluatorIdentity": {
            "pattern": "^renderweave-image-only-profile-successor-diagnostic-evaluator/1\\.0:[0-9a-f]{64}$"
          },
          "maximumRuns": { "const": 1 },
          "maximumProviderCalls": { "const": 5 },
          "maximumModelTokens": { "const": 100000 },
          "maximumCostMicrosCny": { "const": 3000000 },
          "maximumProviderCallsPerRun": { "const": 5 },
          "maximumCostPerRunMicrosCny": { "const": 3000000 },
          "approvalScope": { "const": "IMAGE_ONLY_PROFILE_SUCCESSOR_DIAGNOSTIC_1" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": { "const": "PROFILE_SUCCESSOR_DIAGNOSTIC_1" },
          "profileId": {
            "enum": [
              "dashscope-qwen38-max-product-v49-hybrid-generic",
              "dashscope-qwen38-max-product-v50-hybrid-generic",
              "dashscope-qwen38-max-product-v51-hybrid-generic"
            ]
          }
        },
        "required": ["stage", "profileId"]
      },
      "then": {
        "required": ["normalizationIdentity"],
        "properties": {
          "normalizationIdentity": {
            "type": "string",
            "pattern": "^renderweave-image-only-fresh-normalization/1\\.0:[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
