{
  "name": "@renderweave/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-ts -i ../openapi/renderweave-v1.yaml -o src/api/generated -c @hey-api/client-fetch && node ../tools/generate-template-binding-policy.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run src --passWithNoTests",
    "test:e2e": "playwright test",
    "build": "tsc -b && vite build",
    "check": "npm run api:generate && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.101.4",
    "@xyflow/react": "12.11.2",
    "clsx": "2.1.1",
    "lossless-json": "4.3.0",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "happy-dom": "20.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
