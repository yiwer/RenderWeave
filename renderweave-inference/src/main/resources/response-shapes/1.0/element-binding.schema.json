{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renderweave:stage-response-shape:element-binding:1.0",
  "title": "RenderWeave product-v45 ELEMENT_BINDING response syntax",
  "$comment": "Offline syntax authority only; coverage, field uniqueness and ownership validators remain authoritative. This schema is not sent to a Provider.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "bindings"],
  "properties": {
    "contractVersion": {"const": "renderweave-visual-bindings/2.0"},
    "bindings": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/binding"}}
  },
  "$defs": {
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementId", "entityId"],
      "properties": {
        "elementId": {"$ref": "#/$defs/localId"},
        "entityId": {"$ref": "#/$defs/localId"}
      }
    }
  }
}
