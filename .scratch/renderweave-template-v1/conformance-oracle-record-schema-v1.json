{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:renderweave:conformance-oracle-record:1.0",
  "title": "RenderWeave Conformance Oracle Record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordVersion",
    "oracleId",
    "probeProfile",
    "assertions",
    "supersedes"
  ],
  "properties": {
    "recordVersion": {
      "const": "renderweave-conformance-oracle-record/1.0"
    },
    "oracleId": {
      "$ref": "#/$defs/oracleId"
    },
    "probeProfile": {
      "type": "string",
      "pattern": "^renderweave-conformance-probes/[0-9]+\\.[0-9]+$"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/oracleId"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "oracleId": {
      "type": "string",
      "pattern": "^ORC::(?:WIRE_CANONICAL_DIGEST|DESIGN_INPUT_EXPRESSION|CLOSURE_REPEAT_COMPOSITION_EVALUATOR|ASSET_CAPABILITY_CONCURRENCY|LAYOUT_SHAPING|RENDERER_OUTPUT|SECURITY_FAULT|EDITOR_AUTOMATED|CAPACITY|SPEC_REGISTRY)::[0-9]{6}$"
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "LITERAL"
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "artifactPath",
            "mediaType",
            "artifactSha256"
          ],
          "properties": {
            "kind": {
              "const": "ARTIFACT"
            },
            "artifactPath": {
              "$ref": "#/$defs/relativePath"
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 127
            },
            "artifactSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "probeId",
        "operator"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "pattern": "^A[0-9]{3}$"
        },
        "probeId": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)+$"
        },
        "operator": {
          "enum": [
            "EQ",
            "ABSENT",
            "SEQUENCE_EQ",
            "BYTES_EQ",
            "WITHIN"
          ]
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "ABSENT"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "not": {
              "required": [
                "expected"
              ]
            }
          },
          "else": {
            "required": [
              "expected"
            ]
          }
        }
      ]
    }
  }
}
