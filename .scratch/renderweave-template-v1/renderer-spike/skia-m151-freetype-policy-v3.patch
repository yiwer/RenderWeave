diff --git a/src/ports/SkFontHost_FreeType.cpp b/src/ports/SkFontHost_FreeType.cpp
index f8043f2..c93fa26 100644
--- a/src/ports/SkFontHost_FreeType.cpp
+++ b/src/ports/SkFontHost_FreeType.cpp
@@ -945,6 +945,15 @@ SkScalerContext_FreeType::SkScalerContext_FreeType(const SkTypeface_FreeType& re
         return;
     }
 
+    // RenderWeave admits only scalable outline faces without fixed-size strikes and uses one
+    // no-hinting path.  Reject here before Skia can clear NO_BITMAP or add COLOR below.
+    if (!FT_IS_SCALABLE(fFaceRec->fFace) || fFaceRec->fFace->num_fixed_sizes != 0 ||
+        fRec.getHinting() != SkFontHinting::kNone ||
+        (fRec.fFlags & SkScalerContext::kForceAutohinting_Flag)) {
+        LOG_INFO("RenderWeave rejected an unsupported FreeType face or hinting mode.\n");
+        return;
+    }
+
     fLCDIsVert = SkToBool(fRec.fFlags & SkScalerContext::kLCD_Vertical_Flag);
 
     // compute the flags we send to Load_Glyph
@@ -1000,6 +1009,15 @@ SkScalerContext_FreeType::SkScalerContext_FreeType(const SkTypeface_FreeType& re
             loadFlags |= FT_LOAD_NO_BITMAP;
         }
 
+        // FreeType's tricky-font exception can re-enable native hinting when NO_HINTING is used
+        // alone.  The exact Renderer path also forbids bitmap, SVG, color, and auto-hint loads.
+        loadFlags |= FT_LOAD_NO_HINTING;
+        loadFlags |= FT_LOAD_NO_AUTOHINT;
+        loadFlags |= FT_LOAD_NO_BITMAP;
+        loadFlags |= FT_LOAD_NO_SVG;
+        loadFlags &= ~FT_LOAD_FORCE_AUTOHINT;
+        loadFlags &= ~FT_LOAD_COLOR;
+
         // Always using FT_LOAD_IGNORE_GLOBAL_ADVANCE_WIDTH to get correct
         // advances, as fontconfig and cairo do.
         // See http://code.google.com/p/skia/issues/detail?id=222.
@@ -1102,6 +1120,17 @@ SkScalerContext_FreeType::SkScalerContext_FreeType(const SkTypeface_FreeType& re
         return;
     }
 
+    constexpr FT_Int32 kRenderWeaveRequiredLoadFlags =
+            FT_LOAD_NO_HINTING | FT_LOAD_NO_AUTOHINT | FT_LOAD_NO_BITMAP | FT_LOAD_NO_SVG;
+    constexpr FT_Int32 kRenderWeaveForbiddenLoadFlags =
+            FT_LOAD_FORCE_AUTOHINT | FT_LOAD_COLOR;
+    if ((fLoadGlyphFlags & kRenderWeaveRequiredLoadFlags) !=
+                kRenderWeaveRequiredLoadFlags ||
+        (fLoadGlyphFlags & kRenderWeaveForbiddenLoadFlags) != 0) {
+        LOG_INFO("RenderWeave FreeType load-flag invariant failed.\n");
+        return;
+    }
+
     fMatrix22.xx = SkScalarToFixed(fMatrix22Scalar.getScaleX());
     fMatrix22.xy = SkScalarToFixed(-fMatrix22Scalar.getSkewX());
     fMatrix22.yx = SkScalarToFixed(-fMatrix22Scalar.getSkewY());
